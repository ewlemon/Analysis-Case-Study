      <aliases enabled='yes' />
      <column datatype='real' name='[Actual Hours]' role='measure' type='quantitative' />
      <column caption='Utilization Percentage' datatype='real' name='[Calculation_1082271332473827329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Actual Hours]) / SUM([Capacity Hours]) * 100' />
      </column>
      <column caption='Hits Target' datatype='boolean' name='[Calculation_1082271332474241027]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Actual Hours]) / SUM([Capacity Hours]) &gt;= 1' />
      </column>
      <column caption='Capacity Target' datatype='integer' name='[Calculation_167196183201828864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1400' />
      </column>
      <column caption='Overall Utilization Rate' datatype='real' name='[Calculation_167196183203172353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='18110.2 / 18716.8' />
      </column>
      <column caption='At Target' datatype='boolean' name='[Calculation_2294865532098326528]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([Pivot Field Values]) &gt;= 1' />
      </column>
      <column caption='Rolling Avg' datatype='real' name='[Calculation_2294865532110712835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([Pivot Field Values]), -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
