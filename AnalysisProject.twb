      <aliases enabled='yes' />
      <column caption='Trend Line Value' datatype='real' name='[Calculation_2054767377018548224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(-0.0951 * AVG([Distance from Residence to Work])) + 144.926' />
      </column>
      <column caption='Above Trend Line' datatype='boolean' name='[Calculation_2054767377018613761]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Absenteeism time in hours]) &gt; (-0.0951 * AVG([Distance from Residence to Work])) + 144.926' />
      </column>
      <column caption='Unlikely to Stay Pct' datatype='real' name='[Calculation_2054767377021861890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [HI4_WantstoStay] &lt;= 2 THEN 1 ELSE 0 END) / COUNT([ID]) * 100' />
      </column>
      <column caption='Highest Absentee' datatype='string' name='[Calculation_2326953679424507904]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Absenteeism time in hours]) = WINDOW_MAX(AVG([Absenteeism time in hours])) THEN &quot;Highest&quot; ELSE &quot;Other&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
