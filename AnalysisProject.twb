    <worksheet name='Distance vs Absentee Time Scatter'>
      <table>
        <view>
          <datasources>
            <datasource caption='clean_absenteeism+ (Multiple Connections)' name='federated.1k0mh030bzwml01cgr0kp00a0aqg' />
          </datasources>
          <datasource-dependencies datasource='federated.1k0mh030bzwml01cgr0kp00a0aqg'>
            <column datatype='integer' name='[Absenteeism time in hours]' role='measure' type='quantitative' />
            <column caption='Above Trend Line' datatype='boolean' name='[Calculation_2054767377018613761]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SUM([Absenteeism time in hours]) &gt; (-0.0951 * AVG([Distance from Residence to Work])) + 144.926' />
            </column>
            <column datatype='integer' name='[Distance from Residence to Work]' role='measure' type='quantitative' />
            <column datatype='integer' name='[ID]' role='dimension' type='ordinal' />
            <column-instance column='[Distance from Residence to Work]' derivation='Avg' name='[avg:Distance from Residence to Work:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ID]' derivation='None' name='[none:ID:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Absenteeism time in hours]' derivation='Sum' name='[sum:Absenteeism time in hours:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2054767377018613761]' derivation='User' name='[usr:Calculation_2054767377018613761:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='label'>
            <format attr='font-weight' field='[federated.1k0mh030bzwml01cgr0kp00a0aqg].[avg:Distance from Residence to Work:qk]' value='bold' />
            <format attr='font-weight' field='[federated.1k0mh030bzwml01cgr0kp00a0aqg].[sum:Absenteeism time in hours:qk]' value='bold' />
            <format attr='text-format' field='[federated.1k0mh030bzwml01cgr0kp00a0aqg].[sum:Absenteeism time in hours:qk]' value='n#,##0.0;-#,##0.0' />
            <format attr='text-format' field='[federated.1k0mh030bzwml01cgr0kp00a0aqg].[avg:Distance from Residence to Work:qk]' value='n#,##0.0;-#,##0.0' />
          </style-rule>
        </style>
        <panes>
